    info "Checking GCP deployment status..."
    echo ""
    echo "ControlNet:"
    gcloud run services describe controlnet-gateway-dev \
        --region=$REGION \
        --project=$PROJECT_ID \
        --format="table(status.url,status.traffic[0].revisionName,status.traffic[0].percent)" 2>/dev/null || echo "Not deployed"
    
    echo ""
    echo "Web:"
    gcloud run services describe web-app-dev \
        --region=$REGION \
        --project=$PROJECT_ID \
        --format="table(status.url,status.traffic[0].revisionName,status.traffic[0].percent)" 2>/dev/null || echo "Not deployed"
    
    echo ""
    echo "ModelGuard:"
    gcloud run services describe model-guard-dev \
        --region=$REGION \
        --project=$PROJECT_ID \
        --format="table(status.url,status.traffic[0].revisionName,status.traffic[0].percent)" 2>/dev/null || echo "Not deployed"
}



# Commands implementation
cmd_up() {
    info "Starting all services..."
    
    # ========================================================
    # Check for GCP Application Default Credentials (ADC)
    # ========================================================
    ADC_PATH="$HOME/.config/gcloud/application_default_credentials.json"
    
    if [ ! -f "$ADC_PATH" ]; then
        echo ""
        warn "GCP credentials not found!"
        echo ""
        echo "  Application Default Credentials (ADC) are required for:"
        echo "  - LanceDB connection to GCS"
        echo "  - ONNX model loading from GCS"
        echo "  - Risk detection features"
        echo ""
        echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${GREEN}💡 SETUP (One-Time):${NC}"
        echo ""
        echo "  1. Authenticate with GCP:"
        echo -e "     ${BLUE}gcloud auth application-default login${NC}"
        echo ""
        echo "  2. Set your project:"
        echo -e "     ${BLUE}gcloud config set project YOUR_PROJECT_ID${NC}"
        echo ""
        echo "  3. Verify credentials created:"
        echo -e "     ${BLUE}ls -la ~/.config/gcloud/application_default_credentials.json${NC}"
        echo ""
        echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        read -p "Run authentication now? (Y/n) " -n 1 -r
        echo
        
        if [[ ! $REPLY =~ ^[Nn]$ ]]; then
            info "Running gcloud authentication..."
            gcloud auth application-default login
            
            if [ $? -eq 0 ]; then
                success "Authentication complete!"
                echo ""
                info "Configure your GCP project:"
                echo -e "     ${BLUE}gcloud config set project YOUR_PROJECT_ID${NC}"
                echo ""
            else
                error "Authentication failed. Please try again manually."
            fi
        else
            echo ""
            warn "Skipping authentication. Services may fail to start."
            warn "Run 'gcloud auth application-default login' before starting services."
            echo ""
            read -p "Continue anyway? (y/N) " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                info "Aborted. Run './dev up' again after authentication."
                exit 0
            fi
        fi
    else
        success "GCP credentials found at $ADC_PATH"
    fi
    
    echo ""
    info "Starting Docker services..."
    docker-compose -f docker-compose.dev.yml up -d
    
    echo ""
    success "Services started! 🚀"
    echo ""
    echo -e "  Access:"
    echo -e "    - All services: ${BLUE}http://localhost${NC}"
    echo -e "    - ControlNet API: ${BLUE}http://localhost:8000${NC}"
    echo -e "    - ONNX Service: ${BLUE}http://localhost:8002${NC}"
    echo -e "    - Web App: ${BLUE}http://localhost:3000${NC}"
    echo -e "    - ModelGuard: ${BLUE}http://localhost:8001${NC}"
    echo ""
    echo -e "  Next steps:"
    echo -e "    - View logs: ${GREEN}./dev logs${NC}"
    echo -e "    - Check health: ${GREEN}./dev health${NC}"
    echo -e "    - Open shell: ${GREEN}./dev shell${NC}"
    echo ""
}

cmd_down() {
    info "Stopping all services..."
    docker-compose -f docker-compose.dev.yml down
    success "Services stopped"
}

cmd_restart() {
    cmd_down
    cmd_up
}

cmd_logs() {
    local service="$1"
    if [ -z "$service" ]; then
        docker-compose -f docker-compose.dev.yml logs -f --tail=100
    else
        docker-compose -f docker-compose.dev.yml logs -f --tail=100 "$service"
    fi
}

cmd_logs_gcp() {
    local service="$1"
    
    # Interactive prompt if no service specified
    if [ -z "$service" ]; then
        echo ""
        info "Select GCP service to stream logs from:"
        echo ""
        echo "  1) ControlNet Gateway"
        echo "  2) Web App"
        echo "  3) Model Guard"
        echo "  4) ONNX Service"
        echo "  5) All Cloud Run Services"
        echo "  6) List available services first"
        echo ""
        read -p "Enter choice (1-6): " choice
        
        case "$choice" in
            1) service="controlnet-gateway" ;;
            2) service="web-app" ;;
            3) service="model-guard" ;;
            4) service="onnx-inference-service" ;;
            5) service="all" ;;
            6) 
                info "Fetching available Cloud Run services..."
                echo ""
                gcloud run services list --project="$PROJECT_ID" --region="$REGION" 2>/dev/null
                echo ""
                read -p "Enter service name: " service
                [ -z "$service" ] && error "Service name required"
                ;;
            *) error "Invalid choice" ;;
        esac
    fi
    
    # Check log severity level
    echo ""
    info "Select log level to stream:"
    echo ""
    echo "  1) All logs"
    echo "  2) INFO and above (default)"
    echo "  3) WARNING and above"
    echo "  4) ERROR only"
    echo ""
    read -p "Enter choice (1-4, default 2): " level_choice
    level_choice=${level_choice:-2}
    
    local severity_filter=""
    case "$level_choice" in
        1) severity_filter="" ;;
        2) severity_filter="severity>=INFO" ;;
        3) severity_filter="severity>=WARNING" ;;
        4) severity_filter="severity>=ERROR" ;;
    esac
    
    # Select time window
    echo ""
    info "Select time window:"
    echo ""
    echo "  1) Last 5 minutes"
    echo "  2) Last 1 hour (default)"
    echo "  3) Last 24 hours"
    echo ""
    read -p "Enter choice (1-3, default 2): " time_choice
    time_choice=${time_choice:-2}
    
    local freshness=""
    case "$time_choice" in
        1) freshness="5m" ;;
        2) freshness="1h" ;;
        3) freshness="24h" ;;
    esac
    
    info "Streaming GCP logs for $service..."
    echo ""
    
    if [ "$service" = "all" ]; then
        # Stream logs from all Cloud Run services
        local filter="resource.type=\"cloud_run_revision\""
        [ -n "$severity_filter" ] && filter="$filter AND $severity_filter"
        
        info "Streaming combined logs (refreshing every 5s, Ctrl+C to stop)..."
        info "Filter: $filter"
        echo ""
        
        # First check if there are any logs
        local test_result=$(gcloud logging read "$filter" \
            --project="$PROJECT_ID" \
            --limit=1 \
            --freshness="$freshness" \
            2>&1)
        
        if [ -z "$test_result" ] || echo "$test_result" | grep -q "ERROR"; then
            warn "No logs found or error accessing logs. Showing recent Cloud Run activity..."
            echo ""
            gcloud logging read "resource.type=\"cloud_run_revision\"" \
                --project="$PROJECT_ID" \
                --limit=10 \
                --format="table(timestamp.date('%Y-%m-%d %H:%M:%S'),resource.labels.service_name,severity,textPayload)" \
                --freshness="24h"
            exit 0
        fi
        
        # Use continuous polling
        echo -e "${BLUE}━━━ GCP Logs Stream ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo "Project: $PROJECT_ID | Filter: $filter"
        echo "Showing last 25 entries | Updates append below | Press Ctrl+C to stop"
        echo ""
        
        while true; do
            gcloud logging read "$filter" \
                --project="$PROJECT_ID" \
                --limit=25 \
                --format="table(timestamp.date('%Y-%m-%d %H:%M:%S'),resource.labels.service_name:label=SERVICE,severity:label=LEVEL,textPayload:label=MESSAGE)" \
                --freshness="$freshness" \
                2>/dev/null && echo "" || echo "No new logs..."
            
            echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            sleep 5
        done
    else
        # Stream logs from specific service
        local filter="resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"$service\""
        [ -n "$severity_filter" ] && filter="$filter AND $severity_filter"
        
        info "Streaming logs from $service (refreshing every 5s, Ctrl+C to stop)..."
        info "Filter: $filter"
        echo ""
        
        # First check if service exists and has logs
        local test_result=$(gcloud logging read "$filter" \
            --project="$PROJECT_ID" \
            --limit=1 \
            --freshness="$freshness" \
            2>&1)
        
        if [ -z "$test_result" ] || echo "$test_result" | grep -q "ERROR"; then
            warn "No logs found for service '$service'"
            echo ""
            info "Available Cloud Run services:"
            gcloud run services list --project="$PROJECT_ID" --region="$REGION" --format="value(metadata.name)" 2>/dev/null
            exit 0
        fi
        
        echo -e "${BLUE}━━━ GCP Logs: $service ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo "Project: $PROJECT_ID | Updates append below | Press Ctrl+C to stop"
        echo ""
        
        while true; do
            gcloud logging read "$filter" \
                --project="$PROJECT_ID" \
                --limit=25 \
                --format="table(timestamp.date('%Y-%m-%d %H:%M:%S'),severity:label=LEVEL,textPayload:label=MESSAGE)" \
                --freshness="$freshness" \
                2>/dev/null && echo "" || echo "No new logs..."
            
            echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            sleep 5
        done
    fi
}

cmd_logs_gcp_search() {
    local search_term="$1"
    
    if [ -z "$search_term" ]; then
        read -p "Enter search term: " search_term
        [ -z "$search_term" ] && error "Search term is required"
    fi
    
    info "Searching GCP logs for: $search_term"
    echo ""
    
    # Search in last 1 hour by default
    local filter="resource.type=\"cloud_run_revision\" AND textPayload=~\"$search_term\""
    
    gcloud logging read "$filter" \
        --project="$PROJECT_ID" \
        --limit=50 \
        --format="table(timestamp.date('%Y-%m-%d %H:%M:%S'),resource.labels.service_name,severity,textPayload)" \
        --freshness=1h
}

cmd_logs_gcp_errors() {
    info "Streaming ERROR logs from all GCP services (refreshing every 5s, Ctrl+C to stop)..."
    echo ""
    
    local filter="resource.type=\"cloud_run_revision\" AND severity>=ERROR"
    
    while true; do
        gcloud logging read "$filter" \
            --project="$PROJECT_ID" \
            --limit=15 \
            --format="table(timestamp.date('%Y-%m-%d %H:%M:%S'),resource.labels.service_name,severity,textPayload)" \
            --freshness=10s \
            2>/dev/null
        sleep 5
        printf "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"
    done
}

cmd_onnx_debug() {
    local service_name="onnx-inference-service-dev"
    
    info "ONNX Service Diagnostics"
    echo ""
    
    # Get service URL
    info "Fetching service URL..."
    local service_url=$(gcloud run services describe "$service_name" \
        --region="$REGION" \
        --project="$PROJECT_ID" \
        --format='value(status.url)' 2>/dev/null)
    
    if [ -z "$service_url" ]; then
        error "Service not found: $service_name"
    fi
    
    echo "Service URL: $service_url"
    echo ""
    
    # Check health
    info "Checking health endpoint..."
    curl -s "$service_url/health" | jq '.' || echo "Failed to fetch health"
    echo ""
    
    # Check model cache
    info "Checking loaded models..."
    curl -s "$service_url/models" | jq '.' || echo "Failed to fetch models"
    echo ""
    
    # Check recent logs for PII
    info "Recent PII-related logs (last 10 minutes)..."
    gcloud logging read "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"$service_name\" AND textPayload:\"pii\"" \
        --project="$PROJECT_ID" \
        --limit=10 \
        --format="table(timestamp.date('%Y-%m-%d %H:%M:%S'),severity,textPayload)" \
        --freshness=10m
    echo ""
    
    # Show current revision
    info "Current revision details..."
    gcloud run revisions list \
        --service="$service_name" \
        --region="$REGION" \
        --project="$PROJECT_ID" \
        --limit=1 \
        --format="table(metadata.name,status.conditions[0].lastTransitionTime,metadata.labels)"
}

cmd_shell() {
    local service="${1:-controlnet}"
    info "Opening shell in $service..."
    docker-compose -f docker-compose.dev.yml exec "$service" /bin/bash
}

cmd_clean() {
    warn "This will remove all Docker volumes and caches"
    read -p "Continue? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        docker-compose -f docker-compose.dev.yml down -v
        docker system prune -af
        success "Cleaned"
    fi
}

cmd_build() {
    info "Building all services locally..."
    export DOCKER_BUILDKIT=1
    docker-compose -f docker-compose.dev.yml build
    success "Build complete"
}

cmd_deploy() {
    info "Deploying to GCP (builds all images + applies infrastructure)..."
    echo ""
    echo "This will:"
    echo "  1. Build all Docker images in Cloud Build"
    echo "  2. Apply Terraform infrastructure"
    echo "  3. Deploy all services to Cloud Run"
    echo "  4. Run database migrations"
    echo ""
    
    # Use the unified deployment script
    bash infra/scripts/deploy.sh --project "$PROJECT_ID" --env dev --image-tag latest
}

cmd_deploy_service() {
    local service="$1"
    
    # Interactive prompt if no service specified
    if [ -z "$service" ]; then
        echo ""
        info "Select service to deploy:"
        echo ""
        echo "  1) ControlNet Gateway"
        echo "  2) Web App"
        echo "  3) Model Guard"
        echo "  4) ONNX Service"
        echo ""
        read -p "Enter choice (1-4): " choice
        
        case "$choice" in
            1) service="controlnet" ;;
            2) service="web" ;;
            3) service="model-guard" ;;
            4) service="onnx-service" ;;
            *) error "Invalid choice" ;;
        esac
    fi
    
    # Map service name to Cloud Run service and image names
    local cloud_run_service=""
    local image_name=""
    
    case "$service" in
        controlnet)
            cloud_run_service="controlnet-gateway-dev"
            image_name="controlnet"
            ;;
        web)
            cloud_run_service="web-app-dev"
            image_name="web"
            ;;
        model-guard)
            cloud_run_service="model-guard-dev"
            image_name="model-guard"
            ;;
        onnx-service)
            cloud_run_service="onnx-inference-service-dev"
            image_name="onnx-inference-service-dev"
            ;;
        *)
            error "Unknown service: $service"
            ;;
    esac
    
    info "Deploying $service to Cloud Run..."
    echo ""
    echo "Service: $cloud_run_service"
    echo "Image: ${REGION}-docker.pkg.dev/${PROJECT_ID}/ai-governance/${image_name}:latest"
    echo ""
    warn "This uses the EXISTING image from Artifact Registry."
    warn "To rebuild the image first, use: ./dev deploy"
    echo ""
    read -p "Continue? (Y/n) " -n 1 -r
    echo
    
    if [[ $REPLY =~ ^[Nn]$ ]]; then
        info "Cancelled"
        exit 0
    fi
    
    info "Updating Cloud Run service..."
    gcloud run deploy "$cloud_run_service" \
        --image="${REGION}-docker.pkg.dev/${PROJECT_ID}/ai-governance/${image_name}:latest" \
        --region="$REGION" \
        --project="$PROJECT_ID" \
        --quiet
    
    if [ $? -eq 0 ]; then
        success "Deployment complete!"
        echo ""
        info "Service URL:"
        gcloud run services describe "$cloud_run_service" \
            --region="$REGION" \
            --project="$PROJECT_ID" \
            --format="value(status.url)"
    else
        error "Deployment failed"
    fi
}


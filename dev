cmd_health() {
    info "Checking service health..."
    echo ""
    
    # Local services
    echo "Local Services:"
    curl -s http://localhost:8000/healthz > /dev/null 2>&1 && echo "  ✅ ControlNet (port 8000)" || echo "  ❌ ControlNet"
    curl -s http://localhost:8002/health > /dev/null 2>&1 && echo "  ✅ ONNX Service (port 8002)" || echo "  ❌ ONNX Service"
    curl -s http://localhost:3000 > /dev/null 2>&1 && echo "  ✅ Web (port 3000)" || echo "  ❌ Web"
    curl -s http://localhost:8001/health > /dev/null 2>&1 && echo "  ✅ ModelGuard (port 8001)" || echo "  ❌ ModelGuard"
    
    echo ""
    echo "GCP Services:"
    # Add GCP health checks
}

# Main command router
case "${1:-help}" in
    # Local Development
    up) cmd_up ;;
    down) cmd_down ;;
    restart) cmd_restart ;;
    logs) cmd_logs "$2" ;;
    logs:gcp) cmd_logs_gcp "$2" ;;
    logs:search) cmd_logs_gcp_search "$2" ;;
    logs:errors) cmd_logs_gcp_errors ;;
    shell) cmd_shell "$2" ;;
    clean) cmd_clean ;;
    
    # Building
    build) cmd_build ;;
    
    # Deployment
    deploy) cmd_deploy ;;
    deploy:service) cmd_deploy_service "$2" ;;
    promote) shift; cmd_promote "$@" ;;
    status) cmd_status ;;
    
    # Testing
    test) cmd_test ;;
    verify) cmd_verify ;;
    lint) cmd_lint ;;
    format) cmd_format ;;
    
    # Database (local only)
    db:migrate) cmd_db_migrate ;;
    redis) cmd_redis ;;
    
    # Utilities
    env:sync) cmd_env_sync ;;
    env:show) cmd_env_show ;;
    health) cmd_health ;;
    onnx:debug) cmd_onnx_debug ;;
    
    # Help
    help|--help|-h) show_usage ;;
    
    *)
        error "Unknown command: $1\nRun './dev help' for usage"
        ;;
esac


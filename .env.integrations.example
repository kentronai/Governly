# NORIX integrations. Copy to .env.integrations, uncomment/fill the ones you want, restart the web container.
# OAuth providers need a client id + secret from the provider's developer console.
# Providers marked (no client id) are switched on with <NAME>_ENABLED=true.

# 1Password (Events API)
# 1PASSWORD_EVENTS_ENABLED=true  # (no client id)

# 1Password (SCIM)
# 1PASSWORD_SCIM_ENABLED=true  # (no client id)

# 1Password (Users API)
# 1PASSWORD_USERS_ENABLED=true  # (no client id)

# 3CX
# 3CX_ENABLED=true  # (no client id)

# 8x8
# 8X8_ENABLED=true  # (no client id)

# A-Leads
# A_LEADS_ENABLED=true  # (no client id)

# Absorb LMS
# ABSORB_LMS_CLIENT_ID=
# ABSORB_LMS_CLIENT_SECRET=
# ABSORB_LMS_SCOPES=  # comma separated, required by some providers

# Accelo
# ACCELO_CLIENT_ID=
# ACCELO_CLIENT_SECRET=
# ACCELO_SCOPES=  # comma separated, required by some providers


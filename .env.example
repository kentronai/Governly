# AI Governance - Environment Configuration
# Project-level isolation: Each environment uses a separate GCP project with standard naming

# ============================================================
# ENVIRONMENT
# ============================================================
ENVIRONMENT=production  # Label: production, staging, development

# ============================================================
# GCS BUCKETS
# Format: {project-id}-onnx-models and {project-id}_ai-governance
# ============================================================
GCS_MODEL_BUCKET=your-project-id-onnx-models
GS_BUCKET_NAME=your-project-id_ai-governance

# ============================================================
# ML MODEL CONFIGURATION (matches Terraform lines 220-237)
# ============================================================
PRELOAD_ALL_MODELS=false
ENABLE_ONNX_MODELS=true
ENABLE_EMBEDDING_ROUTER=true
ONNX_INFERENCE_TIMEOUT=5.0
MAX_ONNX_MODEL_SIZE_MB=1000.0

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Local Development: Points to postgres container in docker-compose
# Format: postgresql://user:password@host:port/database
# Production: Uses Cloud SQL private IP (injected via Secret Manager)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_governance

# ============================================================
# APPLICATION SETTINGS
# ============================================================
LOG_LEVEL=INFO
MAX_CONCURRENT_REQUESTS=100
GUARD_TIMEOUT=0.2
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini model seeded into each tenant's Model Registry and selected in Playground.
GEMINI_MODEL=gemini-3.6-flash
# Optional legacy OpenAI models can still be registered separately.
OPENAI_API_KEY=your-openai-api-key-here


# ============================================================
# LOCAL DEVELOPMENT ONLY
# ============================================================
# Redis URL - for docker-compose local dev, points to redis container
# In GCP Cloud Run, this is dynamically set by deployment scripts from Memorystore instance
REDIS_URL=redis://redis:6379

# ============================================================
# GCP CONFIGURATION
# ============================================================
GCP_PROJECT_ID=your-gcp-project-id
PLATFORM_DOMAIN=demo.kentron.ai  # Public domain for HTTPS load balancer

# ============================================================
# HUGGING FACE
# ============================================================
HF_TOKEN=your_hf_token_here

# ============================================================
# ONNX MODEL CACHE
# ============================================================
ONNX_MODEL_CACHE_PATH=/app/model_cache

# ============================================================
# NEXT.JS APP
# ============================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
# Optional. Base URL shown in the copy-paste ControlNet integration snippets
# (Policy → Integration, Playground). Leave EMPTY: the snippets then use the
# origin the dashboard is served from (e.g. https://app.kentron.ai), which is
# where nginx proxies /v1/ to the gateway. Only set this when the gateway is
# deliberately hosted on a different domain than the dashboard.
NEXT_PUBLIC_CONTROLNET_GATEWAY_URL=
NEXT_PUBLIC_STATIC_FILES_BUCKET=your-project-static-files


# ============================================================
# CLERK
# ============================================================
CLERK_FRONTEND_API=your-clerk-domain.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret
CLERK_SECRET_KEY=your-clerk-secret-key

# PostHog Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Feature Flags (Optional)
ENABLE_ANALYTICS=false
ENABLE_DEBUG=true
# Bearer secret used by /api/cron/agent-discovery for scheduled cloud scans.
AGENT_DISCOVERY_CRON_SECRET=
# Connected sources (AWS, Azure, GCP, Databricks, CrewAI, GitHub) are re-scanned
# automatically once their last scan is older than this. Users can still scan
# any time with the Refresh button.
AGENT_DISCOVERY_INTERVAL_HOURS=24

# AI Radar (regulatory-intelligence agent, Admin Center -> AI Radar). Runs every
# RADAR_INTERVAL_HOURS (72 = 3 days) via /api/cron/ai-radar, reusing the cron
# secret above. Model: any OpenAI-compatible provider from lib/llm-providers.ts.
# If RADAR_LLM_API_KEY is empty it falls back to <PROVIDER>_API_KEY (e.g.
# GEMINI_API_KEY). The model is optional: BYOK keys are tried first, then these;
# with none working, AI Radar still runs (search + change detection, no analysis).
RADAR_LLM_PROVIDER=gemini
RADAR_LLM_MODEL=
RADAR_LLM_API_KEY=
RADAR_INTERVAL_HOURS=72
# AI Radar is switched off unless this is "true" (Run now and the schedule both stop).
RADAR_ENABLED=false
# Brave Search API key (free tier, brave.com/search/api): lets AI Radar find official
# government/legislature pages for jurisdictions that have no sources yet.
BRAVE_SEARCH_API_KEY=

# ============================================================
# NANGO (self-hosted, open-source — no Nango cloud account)
# ============================================================
# The Auth + Proxy layer for the Integrations marketplace. The nango-server
# container in docker-compose provides OAuth flows, an encrypted credential
# vault, token auto-refresh, and authenticated proxy calls.
#
# --- Nango server config (consumed by the nango-server container) ---
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=
# Nango shares NORIX's own `postgres` service in a SEPARATE `nango` database
# (created by db/init/01-create-nango-db.sql). It authenticates with the same
# POSTGRES_PASSWORD as the app DB — no separate Nango DB password needed.
# Public base URL of the Nango server (used in webhook/redirect URLs).
# Prod: internal http://nango-server:3003. Dev dashboard: http://localhost:3003
NANGO_SERVER_URL=http://nango-server:3003
# Basic-auth for the self-hosted Nango dashboard (no cloud login).
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=admin
#
# --- NORIX-side config (consumed by the Next.js app) ---
# URL the NORIX server code uses to reach the Nango API (internal network).
NANGO_HOST=http://nango-server:3003
# Secret key from the self-hosted Nango dashboard (Environment Settings).
# Used by NORIX server code to call the Nango API (sessions, proxy, connections).
NANGO_SECRET_KEY=
# Shared secret Nango signs its webhooks with — set the same value in the
# Nango dashboard so NORIX can verify the connection-created webhook.
NANGO_WEBHOOK_SECRET=
# Browser-reachable URLs for the Nango Connect widget. Without these the popup
# defaults to Nango Cloud and stays blank for a self-hosted session (#5432).
# Single self-hosted server image serves both API + Connect UI on 3003.
NEXT_PUBLIC_NANGO_API_URL=http://localhost:3003
NEXT_PUBLIC_NANGO_CONNECT_URL=http://localhost:3003

# AES-256-GCM key for encrypting AWS discovery credentials at rest.
# Generate with: openssl rand -base64 32
AWS_CREDENTIALS_ENCRYPTION_KEY=

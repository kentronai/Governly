# AI Governance - Environment Configuration
# Project-level isolation: Each environment uses a separate GCP project with standard naming

# ============================================================
# ENVIRONMENT
# ============================================================
ENVIRONMENT=production  # Label: production, staging, development

# ============================================================
# GCS BUCKETS
# Format: {project-id}-onnx-models and {project-id}_ai-governance
# ============================================================
GCS_MODEL_BUCKET=your-project-id-onnx-models
GS_BUCKET_NAME=your-project-id_ai-governance

# ============================================================
# ML MODEL CONFIGURATION (matches Terraform lines 220-237)
# ============================================================
PRELOAD_ALL_MODELS=false
ENABLE_ONNX_MODELS=true
ENABLE_EMBEDDING_ROUTER=true
ONNX_INFERENCE_TIMEOUT=5.0
MAX_ONNX_MODEL_SIZE_MB=1000.0

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Local Development: Points to postgres container in docker-compose
# Format: postgresql://user:password@host:port/database
# Production: Uses Cloud SQL private IP (injected via Secret Manager)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_governance

# ============================================================
# APPLICATION SETTINGS
# ============================================================
LOG_LEVEL=INFO
MAX_CONCURRENT_REQUESTS=100
GUARD_TIMEOUT=0.2
OPENAI_API_KEY=your-openai-api-key-here


# ============================================================
# LOCAL DEVELOPMENT ONLY
# ============================================================
# Redis URL - for docker-compose local dev, points to redis container
# In GCP Cloud Run, this is dynamically set by deployment scripts from Memorystore instance
REDIS_URL=redis://redis:6379

# ============================================================
# GCP CONFIGURATION
# ============================================================
GCP_PROJECT_ID=your-gcp-project-id
PLATFORM_DOMAIN=demo.kentron.ai  # Public domain for HTTPS load balancer

# ============================================================
# HUGGING FACE
# ============================================================
HF_TOKEN=your_hf_token_here

# ============================================================
# ONNX MODEL CACHE
# ============================================================
ONNX_MODEL_CACHE_PATH=/app/model_cache

# ============================================================
# NEXT.JS APP
# ============================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
NEXT_PUBLIC_STATIC_FILES_BUCKET=your-project-static-files


# ============================================================
# CLERK
# ============================================================
CLERK_FRONTEND_API=your-clerk-domain.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret
CLERK_SECRET_KEY=your-clerk-secret-key

# PostHog Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Feature Flags (Optional)
ENABLE_ANALYTICS=false
ENABLE_DEBUG=true
# Bearer secret used by /api/cron/agent-discovery for scheduled cloud scans.
AGENT_DISCOVERY_CRON_SECRET=

{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Governly on one Ubuntu VM (Docker Compose). The deployment succeeds only once Governly is installed; on failure delete the resource group to remove everything."
  },
  "parameters": {
    "clerkPublishableKey": { "type": "string", "metadata": { "description": "Clerk publishable key (pk_...) from dashboard.clerk.com > API Keys" } },
    "clerkSecretKey": { "type": "securestring", "metadata": { "description": "Clerk secret key (sk_...)" } },
    "adminUsername": { "type": "string", "defaultValue": "governly" },
    "adminPublicKey": { "type": "securestring", "metadata": { "description": "SSH public key for the admin user (ssh-ed25519 ... or ssh-rsa ...)" } },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v5",
      "allowedValues": ["Standard_D2s_v5", "Standard_D4s_v5", "Standard_D8s_v5", "Standard_B4ms"],
      "metadata": { "description": "D4s_v5 (4 vCPU / 16 GB) runs the ML guard models; D2s_v5 works without them" }
    },
    "allowedSourceAddress": { "type": "string", "defaultValue": "*", "metadata": { "description": "Who may reach ports 80 and 22 (CIDR or *)" } },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" }
  },
  "variables": {
    "name": "governly",
    "dnsLabel": "[concat('governly-', uniqueString(resourceGroup().id))]",
    "fqdn": "[concat(variables('dnsLabel'), '.', parameters('location'), '.cloudapp.azure.com')]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('name'), '-nsg')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          { "name": "http", "properties": { "priority": 100, "access": "Allow", "direction": "Inbound", "protocol": "Tcp", "sourceAddressPrefix": "[parameters('allowedSourceAddress')]", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "80" } },
          { "name": "ssh", "properties": { "priority": 110, "access": "Allow", "direction": "Inbound", "protocol": "Tcp", "sourceAddressPrefix": "[parameters('allowedSourceAddress')]", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "22" } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('name'), '-vnet')]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Network/networkSecurityGroups', concat(variables('name'), '-nsg'))]"],
      "properties": {
        "addressSpace": { "addressPrefixes": ["10.20.0.0/16"] },
        "subnets": [
          { "name": "default", "properties": { "addressPrefix": "10.20.0.0/24", "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', concat(variables('name'), '-nsg'))]" } } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('name'), '-ip')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "properties": { "publicIPAllocationMethod": "Static", "dnsSettings": { "domainNameLabel": "[variables('dnsLabel')]" } }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('name'), '-nic')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', concat(variables('name'), '-vnet'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', concat(variables('name'), '-ip'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig",
            "properties": {
              "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', concat(variables('name'), '-vnet'), 'default')]" },
              "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', concat(variables('name'), '-ip'))]" }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-03-01",
      "name": "[variables('name')]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Network/networkInterfaces', concat(variables('name'), '-nic'))]"],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": {
          "computerName": "[variables('name')]",
          "adminUsername": "[parameters('adminUsername')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": { "publicKeys": [ { "path": "[concat('/home/', parameters('adminUsername'), '/.ssh/authorized_keys')]", "keyData": "[parameters('adminPublicKey')]" } ] }
          }
        },
        "storageProfile": {
          "imageReference": { "publisher": "Canonical", "offer": "ubuntu-24_04-lts", "sku": "server", "version": "latest" },
          "osDisk": { "createOption": "FromImage", "diskSizeGB": 64, "managedDisk": { "storageAccountType": "Premium_LRS" } }
        },
        "networkProfile": { "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('name'), '-nic'))]" } ] }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2024-03-01",
      "name": "[concat(variables('name'), '/install-governly')]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Compute/virtualMachines', variables('name'))]"],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "protectedSettings": {
          "commandToExecute": "[concat('curl -fsSL https://raw.githubusercontent.com/kentronai/Norix/main/deploy/vm-init.sh | NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=''', parameters('clerkPublishableKey'), ''' CLERK_SECRET_KEY=''', parameters('clerkSecretKey'), ''' GOVERNLY_URL=''http://', variables('fqdn'), ''' bash')]"
        }
      }
    }
  ],
  "outputs": {
    "url": { "type": "string", "value": "[concat('http://', variables('fqdn'))]" },
    "redeploy": { "type": "string", "value": "[concat('ssh ', parameters('adminUsername'), '@', variables('fqdn'), ' sudo bash /opt/governly/deploy/vm-init.sh')]" }
  }
}
